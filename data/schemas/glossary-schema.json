{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/glossary-schema.json",
    "title": "Cookbook Glossary",
    "description": "A list of culinary terms with definitions or cross-references to other terms or recipe numbers.",
    "$defs": {
        "GlossaryEntry": {
            "title": "Glossary Entry",
            "type": "object",
            "properties": {
                "term": {
                    "type": "string",
                    "description": "The culinary term being defined or cross-referenced."
                },
                "definition": {
                    "type": "string",
                    "description": "A textual definition of the term."
                },
                "see_recipe": {
                    "type": "string",
                    "description": "Cross-reference to a recipe by its entry identifier (e.g., '1755')."
                },
                "see_term": {
                    "type": "string",
                    "description": "Cross-reference to another glossary term (e.g., 'Cut')."
                },
                "sub_terms": {
                    "type": "array",
                    "description": "Related sub-terms that share this entry's cross-reference.",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "term"
            ],
            "additionalProperties": false
        }
    },
    "type": "array",
    "items": {
        "$ref": "#/$defs/GlossaryEntry"
    }
}
